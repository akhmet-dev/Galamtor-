{
  "name": "galamtor",
  "productName": "Galamtor",
  "version": "1.5.1",
  "description": "Galamtor - Kazakhstani Browser",
  "author": "Galamtor contributors",
  "license": "MIT",
  "homepage": "https://galamtor.web.app",
  "repository": "https://github.com/akhmet-dev/Galamtor-",
  "main": "index.js",
  "scripts": {
    "build:assets": "node scripts/build-firebase.js",
    "prestart": "npm run build:assets",
    "start": "electron .",
    "predist": "npm run build:assets",
    "dist": "electron-builder --mac --dir",
    "dist:win": "npm run build:assets && electron-builder --win nsis --x64 --publish never",
    "prepack": "npm run build:assets",
    "pack": "electron-builder --mac",
    "prerelease": "npm run build:assets",
    "release": "electron-builder --publish onTag",
    "serve": "node server.js",
    "test": "node --test",
    "check": "node --check index.js && node --check preload.js && node --check renderer.js && node --check url-utils.js && node --check lens-utils.js && node --check legal-assistant.js && node --check ncalayer-diagnostics.js && node --check public/auth-flow.js && node --check browser-state.js && node --check welcome-utils.js && node --check browser-controls.js && node --check profile-storage.js && node --check auth-utils.js && node --check security-utils.js && node --check ollama-client.js && node --check chatgpt-plan.js && node --check pet-companion.js && node --check server.js && node --check bookmark-controls.js && node --check public/release-utils.js && node --check public/github-releases.js && node --check auth-server.js && node --check auth-session.js && node --check public/async-operations.js && node --check public/auth-page.js && npm run build:assets",
    "test:ui": "node scripts/qa-smoke.cjs",
    "test:web": "node scripts/qa-web.cjs",
    "test:backend": "node scripts/qa-backend.cjs"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "firebase": "^13.0.0",
    "playwright": "^1.64.0"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "build": {
    "appId": "com.galamtor.app",
    "files": [
      "index.js",
      "preload.js",
      "renderer.js",
      "url-utils.js",
      "lens-utils.js",
      "legal-assistant.js",
      "ncalayer-diagnostics.js",
      "index.html",
      "style.css",
      "assets/**",
      "vendor/firebase-compat.js",
      "LICENSE",
      "package.json",
      "browser-state.js",
      "welcome-utils.js",
      "pet-companion.js",
      "browser-controls.js",
      "profile-storage.js",
      "auth-utils.js",
      "security-utils.js",
      "ollama-client.js",
      "chatgpt-plan.js",
      "bookmark-controls.js",
      "public/release-utils.js",
      "auth-server.js",
      "auth-session.js",
      "public/async-operations.js"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "akhmet-dev",
        "repo": "Galamtor-"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "dmg": {
      "title": "Galamtor Browser",
      "window": {
        "width": 600,
        "height": 450
      },
      "iconSize": 120,
      "iconTextSize": 12,
      "background": "build/dmg-background.png",
      "contents": [
        {
          "x": 160,
          "y": 220,
          "type": "file"
        },
        {
          "x": 440,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "galamtorRelease": {
    "unsignedPreview": true
  }
}
